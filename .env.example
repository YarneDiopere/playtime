# Copy to .env and fill in.

# Free key from https://steamcommunity.com/dev/apikey (needs a Steam account with a purchase).
STEAM_API_KEY=

# Long random string; keeps people signed in across restarts.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Public address of the site (used for "Sign in through Steam").
BASE_URL=http://localhost:8000
HOST=127.0.0.1
PORT=8000

# How often every tracked profile is snapshotted.
SNAPSHOT_INTERVAL_MINUTES=60
# Store regions users can pick for price estimates. The first is the default.
PRICE_REGIONS=us,de,gb
# Stop tracking profiles nobody has opened in this many days (0 = never).
INACTIVE_AFTER_DAYS=90
MAX_TRACKED_PROFILES=5000
NEW_PROFILES_PER_IP_PER_HOUR=10

# Set to 1 when running behind a reverse proxy (nginx, Caddy) so client IPs are correct.
TRUST_PROXY=0
